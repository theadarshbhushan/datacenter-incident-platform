# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_PORT=27017
MONGO_ROOT_USER=dcadmin
MONGO_ROOT_PASSWORD=changeme_mongo_password
MONGO_DB_NAME=datacenter_incidents
MONGO_URI=mongodb://dcadmin:changeme_mongo_password@mongodb:27017/datacenter_incidents?authSource=admin

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Kafka / Zookeeper ────────────────────────────────────────────────────────
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_PORT=9092
KAFKA_BROKER_ID=1
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_METRICS_TOPIC=server-metrics

# ── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=dc-platform-super-secret-2024-xK9mP2nQ
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── ML / MLflow ──────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_PORT=8001
MLFLOW_TRACKING_URI=file:/app/mlruns

# ── Service Ports ────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
