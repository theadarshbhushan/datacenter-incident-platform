# VaultWatch frontend configuration. Copy to .env.local and adjust. No secrets belong here:
# every VITE_ variable is compiled into the public JavaScript bundle.

# "mock" = in-browser demo backend with sample data. Nothing is emailed, billed or predicted by a
#          live model, and accounts live only in this browser. Not real authentication.
# "api"  = use the FastAPI backend (dc-backend) for sessions, accounts and data.
VITE_API_MODE=mock

# Base URL of the FastAPI backend. Leave empty in development to use the Vite proxy
# (/api -> VITE_PROXY_TARGET), which keeps the session cookie first-party.
VITE_API_URL=

# Where the Vite dev server proxies /api (only read by `npm run dev`).
# VITE_PROXY_TARGET=http://localhost:8000

# WebSocket endpoint for live updates (api mode only). Empty uses the dev proxy.
VITE_WS_URL=

# Public contact addresses shown on the site. Empty values show placeholder @example.com addresses.
VITE_SUPPORT_EMAIL=
VITE_SALES_EMAIL=

# Set to "true" only when Google OAuth is configured on the backend.
VITE_GOOGLE_AUTH_ENABLED=false

# Set to "true" only when a billing provider (e.g. Stripe) is configured on the backend.
VITE_BILLING_ENABLED=false
