# Production image: builds the app and serves it with Caddy, which also forwards /api and /ws to
# the backend and handles HTTPS. The API and the app share one origin, so the session cookie is first-party.
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV VITE_API_MODE=api VITE_API_URL=
RUN npm run build

FROM caddy:2.8-alpine

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
