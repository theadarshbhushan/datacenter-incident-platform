# VaultWatch environment template. Copy to .env and replace every "replace-me" value.
# Never commit .env. Values here are placeholders, not real credentials.

# ── App ──────────────────────────────────────────────────────────────────────
# "development" enables API docs, the console email dev mailbox and a random SECRET_KEY fallback.
# Anything else ("production") requires a strong SECRET_KEY and hides /docs.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Signs CSRF tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-value

# ── Web app, sessions and CORS ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API with cookies. Never "*".
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30
# Keep true. Chrome and Firefox accept Secure cookies on http://localhost; Safari needs HTTPS.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Only true behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Shared secret for service-to-service telemetry routes (/servers, /incidents, /analytics, /ws ...).
# Leave empty to disable those routes entirely.
INTERNAL_API_TOKEN=

# ── Email ────────────────────────────────────────────────────────────────────
# "console": nothing is sent. Messages are logged and, in development, shown at GET /api/v1/dev/mail.
# "smtp": messages are delivered through the SMTP server below.
EMAIL_BACKEND=console
EMAIL_FROM=VaultWatch <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Where contact-form messages are emailed (they are always stored in MongoDB).
CONTACT_INBOX=

# ── Optional providers (not implemented until configured) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BILLING_PROVIDER=

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_PORT=27017
MONGO_ROOT_USER=vaultwatch
MONGO_ROOT_PASSWORD=replace-me
MONGO_DB_NAME=vaultwatch
MONGO_URI=mongodb://vaultwatch:replace-me@mongodb:27017/vaultwatch?authSource=admin

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Kafka / Zookeeper ────────────────────────────────────────────────────────
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_PORT=9092
KAFKA_BROKER_ID=1
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_METRICS_TOPIC=server-metrics

# ── ML / MLflow ──────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_PORT=8001
MLFLOW_TRACKING_URI=file:/app/mlruns

# ── Service ports ────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me
GRAFANA_ROOT_URL=http://localhost:3001

# ── Frontend (build-time, public) ────────────────────────────────────────────
VITE_API_MODE=api
VITE_API_URL=
VITE_WS_URL=
