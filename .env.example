# VaultWatch environment template. Copy to .env and replace every "replace-me" value.
# docker compose reads this file; `uvicorn` run from dc-backend/ reads it too (../.env).
# Never commit .env. Values here are placeholders, not real credentials.

# ── App ──────────────────────────────────────────────────────────────────────
# "development" enables API docs (/docs), the console-email dev mailbox and a random SECRET_KEY fallback.
# Anything else ("production") requires a strong SECRET_KEY and hides /docs.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Signs CSRF tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# (JWT_SECRET from older versions is still accepted as a fallback.)
SECRET_KEY=replace-me-with-a-long-random-value

# ── Database (MongoDB) ───────────────────────────────────────────────────────
# MongoDB Atlas: Atlas -> Connect -> Drivers, then put your database user's password in the string.
# Allow your IP under Atlas -> Network Access. URL-encode special characters in the password.
MONGO_URI=mongodb+srv://replace-me-user:replace-me-password@replace-me-cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=vaultwatch
# Only for `docker compose --profile local-db` (a local MongoDB container). Then use:
# MONGO_URI=mongodb://vaultwatch:<MONGO_ROOT_PASSWORD>@mongodb:27017/?authSource=admin
MONGO_ROOT_USER=vaultwatch
MONGO_ROOT_PASSWORD=
MONGO_PORT=27017
# Pending data migrations run when the API starts. Set false and run `python -m app.migrations upgrade` yourself
# if several API instances start at once.
RUN_MIGRATIONS_ON_STARTUP=true

# ── Web app, sessions and CORS ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API with cookies. Never "*".
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30
# Keep true. Chrome and Firefox accept Secure cookies on http://localhost; Safari needs HTTPS.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Only true behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# ── ML ───────────────────────────────────────────────────────────────────────
# Model bundle loaded once at startup. Empty = dc-backend/app/ml/artifacts/model_bundle.json.gz
ML_MODEL_PATH=
# Hours of synthetic history for the sample environment.
DEMO_SEED_HOURS=28

# ── Email ────────────────────────────────────────────────────────────────────
# "console": nothing is sent. Messages are logged and, in development, shown at GET /api/v1/dev/mail.
# "smtp": messages are delivered through the SMTP server below (e.g. Gmail with an App Password).
EMAIL_BACKEND=console
EMAIL_FROM=VaultWatch <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Where contact-form messages are emailed (they are always stored in MongoDB).
CONTACT_INBOX=

# ── Alert notification channels (optional) ───────────────────────────────────
# Without these, notifications are recorded with status "not_configured" (see GET /api/v1/notifications).
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# ── Optional providers (not implemented until configured) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BILLING_PROVIDER=

# ── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── Simulated telemetry agent (docker compose --profile agent) ───────────────
# Create a key in the app (Integrations -> Create key, scope metrics:write) and paste it here.
AGENT_API_KEY=

# ── Prometheus / Grafana (docker compose --profile observability) ────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Frontend (build-time, public) ────────────────────────────────────────────
VITE_API_MODE=api
VITE_API_URL=
