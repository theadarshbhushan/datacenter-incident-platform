# Backend-only overrides for running `uvicorn` from dc-backend/. The full, documented template is
# ../.env.example. Placeholders only: never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace-me-with-a-long-random-value
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=vaultwatch
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
EMAIL_BACKEND=console
INTERNAL_API_TOKEN=
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_METRICS_TOPIC=server-metrics
ML_SERVICE_URL=http://localhost:8001
