# Backend-only overrides for running `uvicorn` from dc-backend/. The full, documented template is
# ../.env.example. Placeholders only: never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace-me-with-a-long-random-value
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=vaultwatch
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
EMAIL_BACKEND=console
RUN_MIGRATIONS_ON_STARTUP=true
